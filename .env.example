# Runtime
APP_ENV=development
APP_VERSION=0.15.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,test,testserver,backend
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Security boundaries. Demo headers are permitted only in development/demo/test.
# Production requires DEMO_AUTH_ENABLED=false and a random 32+ character signing key.
DEMO_AUTH_ENABLED=true
SESSION_SIGNING_KEY=
SESSION_TIMEOUT_MINUTES=30
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=524288
RATE_LIMIT_PER_MINUTE=120
EXPENSIVE_RATE_LIMIT_PER_MINUTE=30

# Local-first database. PostgreSQL is supported by replacing this URL.
DATABASE_URL=sqlite:///./data/wealthtwin.db
POSTGRES_PASSWORD=
SYNTHETIC_DATA_PATH=../data/synthetic/v5_personas/personas_v2.json
V5_PERSONA_DATA_PATH=../data/synthetic/v5_personas/personas_v2.json
V5_PERSONA_GOLDEN_PATH=../data/synthetic/v5_personas/golden_outcomes_v2.json
FINANCIAL_RULES_PATH=../data/rules/financial_health_v1.json
PLANNING_RULES_PATH=../data/rules/planning_waterfall_v1.json
METHODOLOGY_RULES_PATH=../data/rules/wealth_methodology_v3.json
PUBLIC_DATA_SNAPSHOT_PATH=../data/public/authoritative_public_snapshot_v1.json
CALIBRATION_REGISTRY_PATH=../data/calibration/china_purchasing_power_v1.json
PORTFOLIO_RULES_PATH=../data/rules/portfolio_policy_v1.json
PRODUCT_CATALOG_PATH=../data/products/mock_products_v1.json
FUND_ADVISORY_CATALOG_PATH=../data/products/verified_real_funds_v1.json
TWIN_RULES_PATH=../data/rules/twin_simulation_v1.json
BEHAVIOR_RULES_PATH=../data/rules/behavior_finance_v1.json
CLIENT_PROFILE_RULES_PATH=../data/rules/client_profile_v1.json
LIABILITY_RULES_PATH=../data/rules/liability_engine_v1.json
FAMILY_ENTERPRISE_RULES_PATH=../data/rules/family_enterprise_v1.json
CFS_RULES_PATH=../data/rules/cfs_composer_v1.json
SPECIALIZED_CFS_RULES_PATH=../data/rules/specialized_cfs_v1.json
MONITORING_RULES_PATH=../data/rules/monitoring_v1.json
KNOWLEDGE_BASE_PATH=../data/knowledge/controlled_knowledge_v1.json
DEMO_BENCHMARK_PATH=../data/benchmarks/demo_release_v1.json
V5_RELEASE_BENCHMARK_PATH=../data/benchmarks/v5_release_v2.json
COMPETITION_DATA_ROOT=../data
DEMO_STORY_VERSION=wealthtwin-main-demo-v1.0.0
DEMO_CACHE_TTL_SECONDS=300
DEMO_MAIN_PATH_COUNT=100

# V5 capabilities are additive and remain off in development until their
# migration, contracts and user flow have passed acceptance independently.
ENABLE_V5_FINANCIAL_GRAPH=false
ENABLE_V5_CLIENT_PROFILE=false
ENABLE_V5_LIABILITY_ENGINE=false
ENABLE_V5_PERSISTENT_TWIN=false
ENABLE_V5_FAMILY_ENTERPRISE=false
ENABLE_V5_CFS=false
ENABLE_V5_PRODUCT_ONTOLOGY=false
ENABLE_V5_MONITORING=false
ENABLE_V5_AGENTS=false
ENABLE_V5_CALIBRATION=false

# Safe default: the complete demo runs without an external model.
# Set this to deepseek only when a local key is supplied. Never commit a key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=20
# Production outbound model calls are limited to this exact hostname allowlist.
LLM_ALLOWED_HOSTS=api.deepseek.com

# Frontend. Empty means same-origin /api, as used by Docker Compose.
VITE_API_BASE_URL=
VITE_ENABLE_V5_FINANCIAL_GRAPH=false
VITE_ENABLE_V5_CLIENT_PROFILE=false
VITE_ENABLE_V5_LIABILITY_ENGINE=false
VITE_ENABLE_V5_PERSISTENT_TWIN=false
VITE_ENABLE_V5_FAMILY_ENTERPRISE=false
VITE_ENABLE_V5_CFS=false
VITE_ENABLE_V5_PRODUCT_ONTOLOGY=false
VITE_ENABLE_V5_MONITORING=false
