FROM node:22-alpine AS build

ARG VITE_ENABLE_V5_FINANCIAL_GRAPH=false
ENV VITE_ENABLE_V5_FINANCIAL_GRAPH=$VITE_ENABLE_V5_FINANCIAL_GRAPH
ARG VITE_ENABLE_V5_CLIENT_PROFILE=false
ENV VITE_ENABLE_V5_CLIENT_PROFILE=$VITE_ENABLE_V5_CLIENT_PROFILE
ARG VITE_ENABLE_V5_LIABILITY_ENGINE=false
ENV VITE_ENABLE_V5_LIABILITY_ENGINE=$VITE_ENABLE_V5_LIABILITY_ENGINE
ARG VITE_ENABLE_V5_PERSISTENT_TWIN=false
ENV VITE_ENABLE_V5_PERSISTENT_TWIN=$VITE_ENABLE_V5_PERSISTENT_TWIN
ARG VITE_ENABLE_V5_FAMILY_ENTERPRISE=false
ENV VITE_ENABLE_V5_FAMILY_ENTERPRISE=$VITE_ENABLE_V5_FAMILY_ENTERPRISE
ARG VITE_ENABLE_V5_CFS=false
ENV VITE_ENABLE_V5_CFS=$VITE_ENABLE_V5_CFS
ARG VITE_ENABLE_V5_PRODUCT_ONTOLOGY=false
ENV VITE_ENABLE_V5_PRODUCT_ONTOLOGY=$VITE_ENABLE_V5_PRODUCT_ONTOLOGY
ARG VITE_ENABLE_V5_MONITORING=false
ENV VITE_ENABLE_V5_MONITORING=$VITE_ENABLE_V5_MONITORING

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
